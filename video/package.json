{
  "name": "tashikame-video",
  "private": true,
  "type": "module",
  "description": "タシカメの紹介映像（Remotion）。アプリ本体の workspaces には入れない",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Intro30 out/intro-30s.mp4",
    "narration": "OUT_DIR=public node scripts/narration.mjs Enceladus 1.08",
    "typecheck": "tsc --noEmit",
    "narration:3min": "OUT_DIR=public OUT_NAME=narration-3min SCRIPT_MD=../docs/video/3min-script.md PARAGRAPH=1 PAUSE_SECTION=0.8 node scripts/narration.mjs Enceladus 1.09",
    "render:3min": "remotion render Intro3min out/intro-3min.mp4",
    "sfx": "node scripts/rumble.mjs && node scripts/sfx.mjs",
    "render:3min-stock": "remotion render Intro3minStock out/intro-3min-stock.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
