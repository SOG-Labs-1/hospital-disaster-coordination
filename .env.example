# 訓練モードの部署役の設定（サーバー側の環境変数）。このファイルをコピーして .env を作り、値を入れる。
# .env はコミットしない（.gitignore 済み）。API キーはブラウザ側には渡さない。

# mock（API を使わない決まった返事）か anthropic（Claude）
AI_PROVIDER=mock

# AI_PROVIDER=anthropic のときに使う
ANTHROPIC_API_KEY=
# 部署役のモデル（公式のモデル一覧で確認して指定する）
ANTHROPIC_MODEL=claude-sonnet-5-5
# 振り返りの説明文のモデル（省略時は ANTHROPIC_MODEL）
ANTHROPIC_REVIEW_MODEL=
# 部署役の考える深さ（low / medium / high）。短い返事を何度も返すので low を既定にしている
ANTHROPIC_EFFORT=low

# 映像のナレーション試作用（アプリは使わない）。Google Cloud Text-to-Speech の API キー
GOOGLE_TTS_API_KEY=
